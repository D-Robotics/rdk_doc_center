# ---------------------------------------------------------------------------
# Algolia credentials — copy to `.env` (gitignored). Never commit real values.
# ---------------------------------------------------------------------------
#
# | Variable                 | Sensitivity                         | Where used              |
# |--------------------------|-------------------------------------|-------------------------|
# | ALGOLIA_ADMIN_API_KEY    | SECRET — write/delete index         | npm run algolia:index   |
# | ALGOLIA_SEARCH_API_KEY   | Browser-safe Search-Only key        | build / start (frontend)|
# | ALGOLIA_APP_ID           | Public identifier (ends up in JS)   | build + index           |
# | ALGOLIA_INDEX_NAME       | Not secret (default rdk_doc_center) | build + index           |
#
# Rules:
# - Never put ALGOLIA_ADMIN_API_KEY in docusaurus.config / frontend / CI build step.
# - CI: store keys in GitHub Actions Secrets; do not echo them in logs.
# - Prefer Search-Only key for ALGOLIA_SEARCH_API_KEY (Dashboard → API Keys).
# ---------------------------------------------------------------------------

# Required for indexing (Admin / Write key). CI secret name: ALGOLIA_ADMIN_API_KEY
ALGOLIA_ADMIN_API_KEY=

# Required for local start/build search UI (Search-Only key)
ALGOLIA_APP_ID=
ALGOLIA_SEARCH_API_KEY=

# Optional — not confidential; omit to use rdk_doc_center
# ALGOLIA_INDEX_NAME=rdk_doc_center
